{
  "name": "Markloom",
  "short_name": "Markloom",
  "description": "Markdown editor with live preview, Mermaid diagrams and export to Word, PDF and HTML.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#FFFFFF",
  "theme_color": "#F8F9FA",
  "file_handlers": [
    { "action": "./", "accept": { "text/markdown": [".md", ".markdown", ".mdx"] } }
  ],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
