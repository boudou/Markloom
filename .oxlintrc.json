{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".claude/**",
    ".impeccable/**",
    ".playwright-mcp/**",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }
  ],
  "rules": {
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    // warn: docx.ts styles link runs with `...(link ? { color, underline } : {})`; spelling the
    // fields out as undefined would override the colour that `...style` set before it
    "anti-slop/no-conditional-empty-object-spread": "warn",
    // warn: the lookup tables (syntax node names, MIME types, key names) are indexed by runtime
    // strings, so keeping their literal types would need `in` checks or assertions at each lookup
    "anti-slop/no-known-value-widening": "warn",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    // warn: the existing checks tell apart members of typed unions (a ReactNode, string | Blob,
    // FileReader's string | ArrayBuffer); none of them parses untyped input
    "anti-slop/no-runtime-typeof": "warn",
    "anti-slop/no-shape-in-symbol-names": "error",
    // warn: errorMessage() takes a caught value, which is unknown by nature; setFeatureSetting
    // belongs to the unused feature-settings API in settingsStore
    "anti-slop/no-unknown-parameters": "warn",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    // warn: docx.ts builds docx option bags field by field, and settingsStore's featureSettings
    // has no value contract yet; giving them one is a refactor, not a lint fix
    "anti-slop/no-unsafe-dictionary-type": "warn",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error"
  }
}
