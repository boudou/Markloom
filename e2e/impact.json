{
  "$comment": [
    "Which end-to-end tests a changed file can affect; scripts/e2e-affected.mjs reads it.",
    "fullSuite: a change to any of these runs every test.",
    "areas: glob -> the tags of the tests to run. Globs match paths from the repository root; a file can match several globs and gets all their tags. An empty list means no test is affected (docs, packaging).",
    "A changed e2e/*.spec.ts runs the tags its own titles carry. Any other file that matches nothing runs every test.",
    "Every file under src/ must match a glob here: `node scripts/e2e-affected.mjs --check` fails otherwise."
  ],
  "fullSuite": [
    "package.json",
    "package-lock.json",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "tsconfig.node.json",
    "postcss.config.js",
    "playwright.config.ts",
    "e2e/fixtures.ts",
    "e2e/servers.ts",
    "e2e/tsconfig.json",
    "e2e/folder/**",
    "e2e/impact.json",
    "scripts/e2e-affected.mjs",
    ".github/workflows/e2e.yml",
    "src/*",
    "src/lib/markdown.ts",
    "src/lib/utils.ts",
    "src/lib/motionFeatures.ts",
    "src/components/layout/AppShell.tsx",
    "src/components/ui/**",
    "src/stores/**",
    "src/styles/**",
    "src/types/**"
  ],
  "areas": {
    "src/assets/**": ["@documents"],

    "src/components/layout/CommandPalette.tsx": ["@palette"],
    "src/components/layout/quickOpen.ts": ["@palette", "@documents"],
    "src/components/layout/CloseGuardDialog.tsx": ["@documents"],
    "src/components/layout/ConsentBar.tsx": ["@web"],
    "src/components/layout/MarkloomMark.tsx": ["@documents"],
    "src/components/layout/ProjectLinks.tsx": ["@documents", "@whats-new", "@updates"],
    "src/components/layout/Sidebar.tsx": ["@documents", "@desktop"],
    "src/components/layout/StatusBar.tsx": ["@editing", "@documents", "@settings"],
    "src/components/layout/TitleBar.tsx": ["@documents", "@editing", "@export", "@settings", "@history"],
    "src/components/layout/index.ts": ["@documents"],

    "src/lib/analytics.ts": ["@web"],
    "src/lib/appearance.ts": ["@appearance"],
    "src/lib/appCommands.ts": ["@palette", "@editing", "@settings", "@web"],
    "src/lib/callouts.ts": ["@parity", "@export"],
    "src/lib/desktopFiles.ts": ["@desktop"],
    "src/lib/launchedFiles.ts": ["@desktop"],
    "src/lib/documentActions.ts": ["@documents", "@desktop"],
    "src/lib/documentPath.ts": ["@documents", "@desktop", "@images"],
    "src/lib/drafts.ts": ["@documents"],
    "src/lib/session.ts": ["@documents", "@desktop"],
    "src/lib/projectLinks.ts": ["@documents", "@whats-new", "@updates"],
    "src/lib/shortcuts.ts": ["@editing", "@insert", "@palette", "@settings", "@documents"],
    "src/lib/useDebouncedValue.ts": ["@editing", "@parity", "@diagrams"],
    "src/lib/useResizeDrag.ts": ["@editing", "@settings"],
    "src/lib/useRovingToolbar.ts": ["@editing", "@insert"],

    "src/features/auto-save/**": ["@settings", "@documents"],
    "src/features/editor/codemirror/**": ["@editing", "@insert", "@diagrams", "@math"],
    "src/features/editor/milkdown/**": ["@rich-text", "@editing", "@insert", "@math", "@parity", "@code", "@diagrams", "@images"],
    "src/features/editor/focusToggle.ts": ["@editing"],
    "src/features/editor/components/**": ["@editing", "@insert", "@rich-text", "@documents", "@parity"],
    "src/features/editor/components/MarkdownPreview.tsx": ["@diagrams", "@math", "@images", "@code"],
    "src/features/editor/components/MermaidEditor.tsx": ["@diagrams"],
    "src/features/editor/components/RichTextEditor.tsx": ["@diagrams", "@images"],
    "src/features/editor/hooks/**": ["@documents", "@parity"],
    "src/features/editor/utils/**": ["@parity", "@images", "@code", "@documents"],
    "src/features/editor/types.ts": ["@editing", "@insert"],
    "src/features/export/**": ["@export"],
    "src/features/file-tree/**": ["@documents", "@desktop"],
    "src/features/find-replace/**": ["@editing"],
    "src/features/folder-search/**": ["@documents", "@desktop"],
    "src/features/image-drop/**": ["@images", "@documents"],
    "src/features/math/**": ["@math", "@parity", "@export"],
    "src/features/mermaid/**": ["@diagrams", "@parity", "@export"],
    "src/features/mermaid-toolbar/**": ["@diagrams", "@insert"],
    "src/features/outline/**": ["@editing"],
    "src/features/recent-files/**": ["@documents"],
    "src/features/settings/**": ["@settings", "@updates", "@window", "@history"],
    "src/features/shortcuts-panel/**": ["@settings"],
    "src/features/sync-scroll/**": ["@settings", "@parity"],
    "src/features/syntax-highlight/**": ["@code", "@parity", "@export"],
    "src/features/tabs/**": ["@documents"],
    "src/features/templates/**": ["@documents"],
    "src/features/updates/**": ["@updates"],
    "src/features/version-history/**": ["@history"],
    "src/features/whats-new/**": ["@whats-new"],
    "src/features/word-count/**": ["@editing"],

    "electron/**": ["@desktop", "@window", "@updates"],
    "pwa/**": ["@offline", "@web"],
    "public/**": ["@offline", "@web"],
    "public/appearance.js": ["@appearance"],

    "build/**": [],
    "docs/**": [],
    "tools/**": [],
    "*.md": [],
    "LICENSE": [],
    "start.bat": [],
    "start-desktop.bat": [],
    ".gitignore": [],
    ".gitattributes": [],
    ".oxlintrc.json": [],
    ".github/workflows/ci.yml": [],
    ".github/workflows/pages.yml": [],
    ".github/workflows/release.yml": [],
    ".github/ISSUE_TEMPLATE/**": [],
    ".github/dependabot.yml": [],
    ".github/*.md": []
  }
}
