{
  "name": "markloom",
  "version": "0.7.0",
  "description": "Markdown editor with live preview, Mermaid diagrams, rich-text mode and export to Word, PDF and HTML",
  "keywords": [
    "markdown",
    "markdown-editor",
    "mermaid",
    "wysiwyg",
    "docx",
    "pdf",
    "electron",
    "react"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "oxlint src e2e playwright.config.ts && tsc -p e2e",
    "test:e2e": "playwright test",
    "test:e2e:affected": "node scripts/e2e-affected.mjs",
    "electron:dev": "concurrently -k \"vite --port 1420 --strictPort\" \"wait-on tcp:1420 && cross-env VITE_DEV_SERVER_URL=http://localhost:1420 electron .\"",
    "electron:start": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.43.14",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@lezer/highlight": "1.2.5",
    "@milkdown/kit": "7.22.3",
    "@milkdown/react": "7.22.3",
    "@oxlint/plugins": "1.88.0",
    "@playwright/test": "^1.64.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/file-saver": "^2.0.7",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "diff": "^8.0.2",
    "docx": "^9.12.0",
    "dompurify": "3.4.17",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "file-saver": "^2.0.5",
    "framer-motion": "^14.4.0",
    "highlight.js": "^11.12.0",
    "idb": "^8.0.4",
    "immer": "^11.1.21",
    "jszip": "^3.10.1",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.3.3",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^11.17.2",
    "nanoid": "^5.0.9",
    "oxlint": "1.88.0",
    "postcss": "^8.5.30",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "global-agent": "^4.1.3",
    "katex": "^0.19.0",
    "postcss-selector-parser": "^7.1.7"
  },
  "engines": {
    "node": ">=22.18"
  },
  "main": "electron/main.cjs",
  "author": "boudou (https://github.com/boudou)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boudou/Markloom.git"
  },
  "homepage": "https://github.com/boudou/Markloom#readme",
  "bugs": {
    "url": "https://github.com/boudou/Markloom/issues"
  },
  "build": {
    "appId": "com.markloom.editor",
    "productName": "Markloom",
    "electronDist": "node_modules/electron/dist",
    "publish": {
      "provider": "github",
      "owner": "boudou",
      "repo": "Markloom",
      "releaseType": "draft"
    },
    "electronLanguages": [
      "en-US",
      "el"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdx"
        ],
        "name": "Markdown Document",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    }
  }
}
