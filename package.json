{
  "name": "markloom",
  "version": "0.1.0",
  "description": "Markdown editor with live preview, Mermaid diagrams, rich-text mode and export to Word, PDF and HTML",
  "keywords": [
    "markdown",
    "markdown-editor",
    "mermaid",
    "wysiwyg",
    "docx",
    "pdf",
    "electron",
    "react"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --port 1420 --strictPort\" \"wait-on tcp:1420 && cross-env VITE_DEV_SERVER_URL=http://localhost:1420 electron .\"",
    "electron:start": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "icon": "electron scripts/make-icon.cjs"
  },
  "devDependencies": {
    "@codemirror/commands": "6.10.2",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language": "6.12.1",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.35.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@lezer/highlight": "1.2.3",
    "@milkdown/kit": "7.22.2",
    "@milkdown/react": "7.22.2",
    "@radix-ui/react-context-menu": "^2.2.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tailwindcss/typography": "^0.5.15",
    "@types/file-saver": "^2.0.7",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@uiw/react-codemirror": "^4.23.6",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "diff": "^8.0.2",
    "docx": "^9.0.0",
    "dompurify": "3.3.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "file-saver": "^2.0.5",
    "framer-motion": "^11.15.0",
    "highlight.js": "^11.11.1",
    "idb": "^8.0.3",
    "immer": "^10.1.1",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.4.0",
    "nanoid": "^5.1.16",
    "postcss": "^8.4.49",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^9.5.1",
    "zustand": "^5.0.0"
  },
  "main": "electron/main.cjs",
  "author": "boudou (https://github.com/boudou)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boudou/Markloom.git"
  },
  "homepage": "https://github.com/boudou/Markloom#readme",
  "bugs": {
    "url": "https://github.com/boudou/Markloom/issues"
  },
  "build": {
    "appId": "com.markloom.editor",
    "productName": "Markloom",
    "electronDist": "node_modules/electron/dist",
    "publish": {
      "provider": "github",
      "owner": "boudou",
      "repo": "Markloom",
      "releaseType": "draft"
    },
    "electronLanguages": [
      "en-US",
      "el"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdx"
        ],
        "name": "Markdown Document",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    }
  }
}
